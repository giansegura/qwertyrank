# Copy this file to .env.local. The values point to the services from `docker compose up -d`.
DATABASE_URL=postgres://qwertyrank:qwertyrank@localhost:54329/qwertyrank
# Neon only: direct connection (no pooler) for migrations. Not needed locally.
# DATABASE_URL_UNPOOLED=
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_dev_token
REDIS_KEY_PREFIX=qr:
# Secrets of at least 32 characters. Generate your own with: openssl rand -base64 32
ANON_COOKIE_SECRET=change-me-change-me-change-me-change-me
IP_HASH_SECRET=change-me-change-me-change-me-change-me
# Better Auth: secret of at least 32 characters (openssl rand -base64 32) and the app's public URL.
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
BETTER_AUTH_URL=http://localhost:3000
# Optional. Without these two variables the Google button doesn't show up (see README).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional locally: without a key, emails are written to the `pnpm dev` console and to Redis.
# RESEND_API_KEY=
# EMAIL_FROM=QwertyRank <noreply@qwertyrank.com>
# Optional locally: without these two keys, Ranked doesn't ask for the Cloudflare Turnstile challenge.
# Required in production. Cloudflare test keys that always pass:
# site 1x00000000000000000000BB (invisible) and secret 1x0000000000000000000000000000000AA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Optional locally; required in production (≥ 32 characters): protects the daily job /api/cron/daily.
# CRON_SECRET=
# Optional: without it, Sentry doesn't start. Server only (spec 5a §6.1).
# SENTRY_DSN=
# Optional locally: without it, the development anti-cheat thresholds (src/server/anticheat/config.ts).
# Required in production, with values different from the development ones (those are public). JSON with every field.
# ANTICHEAT_CONFIG=
