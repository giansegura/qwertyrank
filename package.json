{
  "name": "qwertyrank",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "budget": "python3 scripts/budget.py",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:int": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:grant": "node --conditions=react-server --import tsx scripts/admin-role.ts grant",
    "admin:revoke": "node --conditions=react-server --import tsx scripts/admin-role.ts revoke",
    "redis:rebuild": "node --conditions=react-server --import tsx scripts/redis-rebuild.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@sentry/nextjs": "10.75.3",
    "@upstash/redis": "1.39.0",
    "@vercel/functions": "3.9.9",
    "better-auth": "1.7.7",
    "disposable-email-domains-js": "1.26.0",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "obscenity": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.32.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.31.0"
}
